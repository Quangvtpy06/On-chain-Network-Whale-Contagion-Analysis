# Google Cloud Configuration
# Điền GCP Project ID của bạn vào đây (hoặc để trống nếu đã cấu hình qua: gcloud config set project <ID>)
GCP_PROJECT_ID=your-project-id-here

# Tùy chọn: Đường dẫn file Service Account Key JSON (nếu không dùng `gcloud auth application-default login`)
GOOGLE_APPLICATION_CREDENTIALS=credentials.json
